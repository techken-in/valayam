# =============================================================================
# VALAYAM STANDALONE CLI / ENGINE CONFIGURATION
# =============================================================================
# This file documents the environment variable contract shared with
# valayam-platform. Keep in sync with valayam-platform/.env.example

# =============================================================================
# STORAGE CONFIGURATION (Plugins .vpa + YAML Templates)
# =============================================================================
# Shared contract with valayam-platform. Both repos implement identical
# StorageConfig::from_env() logic.

# Storage backend: local | s3 | minio
#   local  — local filesystem / shared volume (default)
#   s3     — Amazon S3 or any S3-compatible API
#   minio  — Minio (S3-compatible, forces path-style addressing)
VALAYAM_STORAGE_BACKEND=local

# Air-gapped / offline mode
# When true: forces backend=local, disables all network egress
# In air-gapped deployments, pre-create a bundle with `valayam bundle create`
# and mount it so the worker sees VALAYAM_PLUGIN_HOME={bundle}/plugins
VALAYAM_OFFLINE_MODE=false

# Plugin storage (encrypted .vpa archives)
# Legacy default: ./data/plugins (if exists) else /var/lib/valayam/plugins
# In bundle mode: point to the extracted bundle's plugins/ dir
VALAYAM_PLUGIN_HOME=./data/plugins

# Extracted WASM plugin cache (runtime)
# Default: ./data/plugin_cache (or $XDG_CACHE_HOME/valayam/plugins_cache)
# In bundle mode: point to the bundle's wasm_cache/ dir
VALAYAM_PLUGIN_CACHE=./data/plugin_cache

# Template storage (raw YAML + versioned blobs)
# Default: ./data/templates
VALAYAM_TEMPLATE_HOME=./data/templates

# Worker plugin acquisition mode: local | store
#   local — watch VALAYAM_PLUGIN_HOME for .vpa files (legacy shared-volume)
#   store — fetch plugin blobs from artifact store on-demand per job
VALAYAM_WORKER_PLUGIN_SOURCE=local

# S3 / Minio settings (required when backend is s3 or minio)
VALAYAM_S3_ENDPOINT=              # e.g. https://s3.us-east-1.amazonaws.com or http://minio:9000
VALAYAM_S3_BUCKET=                # REQUIRED for s3/minio backends
VALAYAM_S3_REGION=us-east-1
VALAYAM_S3_ACCESS_KEY=            # if unset, uses IAM role / instance profile
VALAYAM_S3_SECRET_KEY=            # if unset, uses IAM role / instance profile
VALAYAM_S3_FORCE_PATH_STYLE=false # true for Minio, false for AWS S3

# =============================================================================
# SCANNER / ENGINE SETTINGS
# =============================================================================
# Concurrency / rate limiting
VALAYAM_MAX_CONCURRENT_SCANS=10
VALAYAM_SCAN_TIMEOUT_SECS=300

# Network / proxy
VALAYAM_PROXY_URL=                # e.g. socks5://127.0.0.1:1080

# Telemetry
VALAYAM_LOG_LEVEL=info            # trace, debug, info, warn, error
VALAYAM_METRICS_PORT=9090         # Prometheus metrics endpoint

# =============================================================================
# PLUGIN SETTINGS
# =============================================================================
# Plugin signature verification (Ed25519 public key, PEM format)
VALAYAM_PLUGIN_PUBKEY=            # path to public key file

# Plugin encryption key (AES-256-GCM, base64 encoded, 32 bytes)
# Generate with: openssl rand -base64 32
# When set, all .vpa blobs are encrypted on write and decrypted on read
VALAYAM_PLUGIN_ENC_KEY=